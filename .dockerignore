# Keep the build context (and final image) small + reproducible.
# Anything listed here is NOT sent to the docker daemon during `docker build`.

# --- VCS / editor ---
.git
.gitignore
.gitattributes
.github
.idea
.vscode
*.swp

# --- Python build / cache artefacts ---
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd
.venv
venv
env
.eggs
*.egg-info
streamdiffusionv2.egg-info
build
dist
.pytest_cache
.mypy_cache
.ruff_cache

# --- Node / frontend (rebuilt in stage 1) ---
demo/frontend/node_modules
demo/frontend/.svelte-kit
demo/frontend/build
demo/frontend/.vite
# Pre-existing built assets are regenerated by the frontend-builder stage,
# so don't ship them from the host context.
demo/frontend/public/build

# --- Heavy data: must be mounted at runtime, not baked in ---
ckpts
wan_models
outputs
demo/slo_metrics

# --- Runtime / log noise ---
logs
*.log
*.pid

# --- Local docs / scratch ---
change.md
usage.md

# --- Docker meta itself ---
Dockerfile
.dockerignore
docker-build-push.sh
docker-run.sh
DOCKER.md
